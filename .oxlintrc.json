{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "react", "unicorn", "oxc", "import"],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"browser": true
	},
	"rules": {
		"react-hooks/rules-of-hooks": "error",
		"react-hooks/exhaustive-deps": "warn"
	},
	"ignorePatterns": ["dist", ".astro", ".agents", ".claude"]
}
