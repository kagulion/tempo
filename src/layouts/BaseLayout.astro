---
import '@/index.css';
import { getSupabaseUrl } from '@/lib/supabase';
import { navItems } from './navItems';

interface Props {
	title: string;
	description: string;
	// Путь страницы от корня сайта, например «/». Из него и из `site` строятся canonical и og:url
	path: string;
}

const { title, description, path } = Astro.props;
const url = new URL(path, Astro.site).href;
const image = new URL('/og.png', Astro.site).href;
// Адрес Supabase берём тем же разбором, что и в приложении (там может лежать и один ref проекта):
// preconnect не тратит время на соединение для запроса станций и счётчика. Нет адреса — тега нет
const supabaseUrl = getSupabaseUrl(import.meta.env.VITE_SUPABASE_URL);
---

<!doctype html>
<html lang="ru">
	<head>
		{supabaseUrl && <link rel="preconnect" href={supabaseUrl} crossorigin="" />}
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="text-scale" content="scale" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={url} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#151517" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tempo" />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Tempo: розовый логотип и название на фоне уютной таверны у камина"
		/>
		<meta property="og:locale" content="ru_RU" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
	</head>
	<body>
		<div class="app-shell">
			<header class="app-bar">
				<a
					href="/"
					data-astro-prefetch="hover"
					aria-label="Tempo — главная"
					class="flex items-center gap-2 rounded-full outline-none select-none focus-visible:ring-3 focus-visible:ring-white/30"
				>
					<img src="/logotype.svg" alt="" width={293} height={88} class="h-5 w-auto" />
					<span class="hidden text-[0.6875rem] leading-none text-white/50 sm:inline">бета 0.2</span>
				</a>
				<nav aria-label="Основная навигация" class="flex items-center gap-1">
					{navItems.map((item) => {
						const current = item.href === path;
						return (
							<a
								href={item.href}
								data-astro-prefetch="hover"
								aria-current={current ? 'page' : undefined}
								class:list={[
									'rounded-full px-3 py-1.5 text-sm font-medium transition-colors outline-none focus-visible:ring-3 focus-visible:ring-white/30',
									current ? 'bg-white/10 text-white' : 'text-white/60 hover:text-white'
								]}
							>
								{item.label}
							</a>
						);
					})}
				</nav>
			</header>
			<!-- Рамка: страница живёт внутри неё и мерит себя по ней (см. .app-frame в index.css) -->
			<div class="app-frame">
				<slot />
			</div>
		</div>
	</body>
</html>
